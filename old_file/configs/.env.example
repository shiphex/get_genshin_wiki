# Genshin Wiki Crawler Configuration
# Copy this file to .env and modify values as needed

# MediaWiki API
WIKI_API_URL=https://wiki.biligame.com/ys/api.php
WIKI_BASE_URL=https://wiki.biligame.com/ys/

# Request Settings
REQUEST_INTERVAL=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Storage Settings
OUTPUT_DIR=data
DB_PATH=data/wiki.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log
